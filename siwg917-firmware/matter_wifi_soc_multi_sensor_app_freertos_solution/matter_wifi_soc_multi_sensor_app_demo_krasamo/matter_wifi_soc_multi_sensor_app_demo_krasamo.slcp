- name: _WANT_REENT_SMALL
  value: '1'
- name: NVM3_DEFAULT_NVM_SIZE
  value: '40960'
- name: NVM3_DEFAULT_MAX_OBJECT_SIZE
  value: '4092'
- name: SI917_SOC
  value: '1'
config_file:
- path: config/sl_matter_sensor_config.h
- path: config/common/multi-sensor-wifi-app.zap
